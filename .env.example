# Шаблон переменных окружения для запуска через docker-compose.
# Скопируйте в .env и заполните значения: cp .env.example .env

# --- Безопасность ---
# Список валидных API-ключей через запятую. Если пусто — открытый доступ (режим разработки/MVP).
# Для продакшена обязательно задайте ключи; клиенты передают их в заголовке X-API-Key.
API_KEYS=

# --- Rate limiting ---
# Сколько загрузок видео в минуту разрешено на один ключ/IP.
UPLOAD_RATE_LIMIT_PER_MINUTE=5
# Сколько сообщений LLM-агенту в минуту разрешено на один ключ/IP.
AGENT_RATE_LIMIT_PER_MINUTE=10

# --- LLM-агент (GigaChat) ---
# Провайдер LLM: gigachat (по умолчанию).
LLM_PROVIDER=gigachat
# Ключ API GigaChat. Если пусто — эндпоинт /agent/chat возвращает 503.
LLM_API_KEY=
# Модель GigaChat.
LLM_MODEL=GigaChat
# Проверка TLS-сертификатов при запросах к GigaChat (true/false).
LLM_VERIFY_TLS=true